                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=RunningValue(Fields!Amount_from_purch.Value,Sum,"ItemNo") + RunningValue(Fields!Amount_from_prod.Value,Sum,"ItemNo") + RunningValue(Fields!Amount_from_other_pos.Value,Sum,"ItemNo") + RunningValue(Fields!Amount_from_sale.Value,Sum,"ItemNo") - RunningValue(Fields!Amount_from_cons.Value,Sum,"ItemNo") -RunningValue(Fields!Amount_from_self.Value,Sum,"ItemNo") + RunningValue(Fields!Amount_from_other_neg.Value,Sum,"ItemNo")</Value>
