                                  <Value>=iif(sum(Fields!Amount_from_purch.Value,"Details")+sum(Fields!Amount_from_prod.Value,"Details")+sum(Fields!Amount_from_other_pos.Value,"Details")&lt;&gt;0,sum(Fields!Amount_from_purch.Value,"Details")+sum(Fields!Amount_from_prod.Value,"Details")+sum(Fields!Amount_from_other_pos.Value,"Details"),"")</Value>
                                  <Style>
