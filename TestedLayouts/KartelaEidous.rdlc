                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(sum(Fields!Amount_from_sale.Value,"Details")-sum(Fields!Amount_from_cons.Value,"Details")+sum(Fields!Amount_from_self.Value,"Details")-sum(Fields!Amount_from_other_neg.Value,"Details")&lt;&gt;0,sum(Fields!Amount_from_sale.Value,"Details")-sum(Fields!Amount_from_cons.Value,"Details")+sum(Fields!Amount_from_self.Value,"Details")-sum(Fields!Amount_from_other_neg.Value,"Details"),"")</Value>
