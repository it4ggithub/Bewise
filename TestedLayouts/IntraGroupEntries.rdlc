                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>2. Στοιχεία ενδοομιλικών συναλλαγών (Χρήση: </Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=First(Fields!StartDate.Value, "DataSet_Result")</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>d</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> - </Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=First(Fields!EndDate.Value, "DataSet_Result")</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>d</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>)</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
